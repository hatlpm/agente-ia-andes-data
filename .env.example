# Copia este archivo como `.env` y coloca tu clave real.
# Obten una clave gratuita en: https://aistudio.google.com  ->  "Get API key"
GOOGLE_API_KEY=pega_aqui_tu_api_key_de_google_ai_studio

# Opcionales: solo si quieres cambiar los modelos por defecto.
# Utiles si agotas la cuota gratuita diaria de un modelo: ejecuta
# `python scripts/smoke_test.py` para ver cual sigue disponible y ponlo aqui.
# MODELO_LLM=gemini-flash-lite-latest
# MODELO_EMBEDDING=models/gemini-embedding-001
